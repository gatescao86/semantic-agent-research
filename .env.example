# Copy to .env and fill in. Never commit the real .env file.

# Anthropic
ANTHROPIC_API_KEY=

# Snowflake — used to query SNOWFLAKE_PUBLIC_DATA_FREE (read-only)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# Database/schema for the free public data product. Confirm the exact
# database name after accepting the Marketplace listing — it is typically
# SNOWFLAKE_PUBLIC_DATA_FREE with a CYBERSYN schema, but verify via
# `scripts/setup_snowflake.py` rather than assuming.
SNOWFLAKE_PUBLIC_DATA_DATABASE=SNOWFLAKE_PUBLIC_DATA_FREE
SNOWFLAKE_PUBLIC_DATA_SCHEMA=CYBERSYN
