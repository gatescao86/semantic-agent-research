# Copy to .env and fill in. Never commit the real .env file.

# Anthropic
ANTHROPIC_API_KEY=

# Snowflake — used to query SNOWFLAKE_PUBLIC_DATA_FREE (read-only)
# Key-pair auth (not password) — this account enforces MFA, which plain
# password auth from a script can't satisfy non-interactively. Generate a
# key pair and register the public key with `ALTER USER ... SET
# RSA_PUBLIC_KEY=...` — see README.md for the exact steps.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
# Database/schema for the free public data product. Verified defaults below
# — confirm against your own account via `scripts/setup_snowflake.py` if
# you installed the Marketplace listing under a different local database name.
SNOWFLAKE_PUBLIC_DATA_DATABASE=SNOWFLAKE_PUBLIC_DATA_FREE
SNOWFLAKE_PUBLIC_DATA_SCHEMA=PUBLIC_DATA_FREE
